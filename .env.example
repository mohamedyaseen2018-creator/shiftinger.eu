# ============================================================================
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# Do NOT commit the real .env file.
# ============================================================================

# --- PostgreSQL (bundled `db` service) ---
POSTGRES_DB=shiftinger
POSTGRES_USER=shiftinger
POSTGRES_PASSWORD=change_me_super_secret
POSTGRES_PORT=5432

# --- Backend (TanStack Start SSR + server functions) ---
BACKEND_PORT=3000

# Server-side Supabase config (read by server functions at runtime)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_PROJECT_ID=your-project-id

# --- Frontend (client bundle — VITE_* are baked in at BUILD time) ---
FRONTEND_PORT=8080
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id
